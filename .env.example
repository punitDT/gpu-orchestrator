# Vast.ai Configuration
VAST_API_KEY=your_vast_api_key_here
VAST_MACHINE_ID=your_machine_id_here
GPU_WORKER_URL=http://your-gpu-worker-url:8000

# Timing Configuration (seconds)
IDLE_SHUTDOWN_SECONDS=120
GPU_WARMUP_TIMEOUT_SECONDS=300
GPU_HEALTH_CHECK_INTERVAL_SECONDS=5

# Rate Limiting
MAX_CONCURRENT_GPU_REQUESTS=3
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Request Configuration
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0

# Cache Configuration
GPU_STATUS_CACHE_SECONDS=10

# Server Configuration
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins or "*")
CORS_ORIGINS=*

# Application Metadata
APP_NAME=GPU Orchestrator
APP_VERSION=1.0.0

